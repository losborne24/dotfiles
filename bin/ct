#!/usr/bin/env bash
set -e

if [[ -z "$1" ]]; then
  echo 'Usage: ct "<commit-message>"'
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a Git worktree"
  exit 1
fi

MESSAGE="$1"

echo "Changes:"
git status --short

echo
git diff --stat

echo
read -r -p "Commit these changes? [y/N] " CONFIRM

if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
  echo "Cancelled."
  exit 0
fi

git add .
git commit -m "$MESSAGE"

BRANCH=$(git branch --show-current)

echo
read -r -p "Push $BRANCH? [y/N] " PUSH

if [[ "$PUSH" == "y" || "$PUSH" == "Y" ]]; then
  git push -u origin "$BRANCH"
fi
