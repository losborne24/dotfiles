#!/usr/bin/env bash
set -e

NAME=""
REPO_NAME="Treasury2"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: et [-r <repo>] [<worktree>]"
      echo
      echo "With no arguments, removes the worktree you are currently in."
      echo "With <worktree>, removes that worktree by name from anywhere."
      exit 0
      ;;
    -r|--repo)
      shift
      REPO_NAME="$1"
      ;;
    *)
      if [[ -z "$NAME" ]]; then
        NAME="$1"
      else
        echo "Unknown argument: $1"
        exit 1
      fi
      ;;
  esac
  shift
done

# Locate the main repository, either from the current directory or by name.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
  REPO=$(cd "$(dirname "$GIT_DIR")" && pwd)
elif [[ -z "$NAME" ]]; then
  echo "Not inside a Git worktree"
  exit 1
else
  REPO="$HOME/Documents/GitHub/$REPO_NAME"
  if [[ ! -d "$REPO" ]]; then
    echo "Repository not found: $REPO"
    exit 1
  fi
fi

if [[ -z "$NAME" ]]; then
  WORKTREE=$(git rev-parse --show-toplevel)
else
  # Match the name against the basename of each registered worktree.
  WORKTREE=""
  while read -r _ PATH_FOUND; do
    if [[ "$(basename "$PATH_FOUND")" == "$NAME" || "$PATH_FOUND" == "$NAME" ]]; then
      WORKTREE="$PATH_FOUND"
      break
    fi
  done < <(git -C "$REPO" worktree list --porcelain | grep '^worktree ')

  if [[ -z "$WORKTREE" ]]; then
    echo "No worktree named '$NAME' in $REPO"
    echo "Available:"
    git -C "$REPO" worktree list
    exit 1
  fi
fi

if [[ "$WORKTREE" == "$REPO" ]]; then
  if [[ -z "$NAME" ]]; then
    echo "You're in the main repository, not a worktree"
  else
    echo "'$NAME' is the main repository, not a worktree"
  fi
  exit 1
fi

if [[ -n "$(git -C "$WORKTREE" status --porcelain)" ]]; then
  echo "ERROR: Worktree has uncommitted changes:"
  git -C "$WORKTREE" status --short
  exit 1
fi

cd "$REPO"
git worktree remove "$WORKTREE"

echo "Removed: $WORKTREE"
