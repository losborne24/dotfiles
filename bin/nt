#!/usr/bin/env bash
set -e

TASK=""
REPO_NAME="Treasury2"
IDE="idea"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --vscode)
      IDE="code"
      ;;
    --idea)
      IDE="idea"
      ;;
    --repo)
      shift
      REPO_NAME="$1"
      ;;
    *)
      if [[ -z "$TASK" ]]; then
        TASK="$1"
      else
        echo "Unknown argument: $1"
        exit 1
      fi
      ;;
  esac
  shift
done

if [[ -z "$TASK" ]]; then
  echo "Usage: nt <task> [--repo <repo>] [--idea|--vscode]"
  exit 1
fi

REPO="$HOME/code/$REPO_NAME"
WORKTREES="$HOME/code/$REPO_NAME-worktrees"
WORKTREE="$WORKTREES/$TASK"

if [[ ! -d "$REPO" ]]; then
  echo "Repository not found: $REPO"
  exit 1
fi

if [[ -d "$WORKTREE" ]]; then
  echo "Worktree already exists: $WORKTREE"
  exit 1
fi

mkdir -p "$WORKTREES"

cd "$REPO"
git worktree add "$WORKTREE" -b "$TASK"

cd "$WORKTREE"

echo "Created $TASK"
echo "Repo: $REPO_NAME"
echo "Worktree: $WORKTREE"

"$IDE" .
claude
