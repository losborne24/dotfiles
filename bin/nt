#!/usr/bin/env bash
set -e

TASK=""
REPO_NAME="Treasury2"
IDE="idea"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--vscode)
      IDE="code"
      ;;
    -i|--idea)
      IDE="idea"
      ;;
    -r|--repo)
      shift
      REPO_NAME="$1"
      ;;
    *)
      if [[ -z "$TASK" ]]; then
        TASK="$1"
      else
        echo "Unknown argument: $1"
        exit 1
      fi
      ;;
  esac
  shift
done

if [[ -z "$TASK" ]]; then
  echo "Usage: nt [-v|-i] [-r <repo>] <task>"
  exit 1
fi

REPO="$HOME/Documents/GitHub/$REPO_NAME"
WORKTREES="$HOME/Documents/GitHub/$REPO_NAME-worktrees"
WORKTREE="$WORKTREES/$TASK"

if [[ ! -d "$REPO" ]]; then
  echo "Repository not found: $REPO"
  exit 1
fi

if [[ -d "$WORKTREE" ]]; then
  echo "Worktree already exists: $WORKTREE"
  exit 1
fi

mkdir -p "$WORKTREES"

cd "$REPO"
git worktree add "$WORKTREE" -b "$TASK"

cd "$WORKTREE"

echo "Created $TASK"
echo "Repo: $REPO_NAME"
echo "Worktree: $WORKTREE"

"$IDE" . >/dev/null 2>&1 &
disown

# Open a terminal tab in the current cmux workspace and run claude in it.
if command -v cmux >/dev/null 2>&1; then
  SURFACE_OUT="$(cmux new-surface \
    --type terminal \
    --working-directory "$WORKTREE" \
    --focus true 2>&1)" || SURFACE_OUT=""

  # Send to the new surface explicitly; the default target is this terminal.
  SURFACE_REF="$(printf '%s' "$SURFACE_OUT" | grep -o 'surface:[0-9]\+' | head -1)"
  if [[ -n "$SURFACE_REF" ]]; then
    cmux send --surface "$SURFACE_REF" 'claude\n' >/dev/null 2>&1 || true
  else
    echo "Opened a cmux tab but could not resolve its surface; run claude manually."
  fi
fi

# The nt shell function reads this to cd the calling shell into the worktree.
if [[ -n "$NT_CD_FILE" ]]; then
  printf '%s\n' "$WORKTREE" >"$NT_CD_FILE"
fi
